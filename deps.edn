{:paths   ["resources" "src/clj" "env/prod"]
 :deps    {org.clojure/clojure               {:mvn/version "1.12.5"}
           cheshire/cheshire                 {:mvn/version "5.13.0"}
           ring/ring-jetty-adapter           {:mvn/version "1.15.4"}
           compojure/compojure               {:mvn/version "1.7.2"}
           ring/ring-json                    {:mvn/version "0.5.1"}
           ring/ring-devel                   {:mvn/version "1.15.4"}
           ring/ring-codec                   {:mvn/version "1.3.0"}
           mount/mount                       {:mvn/version "0.1.24"}
           clj-http/clj-http                 {:mvn/version "3.13.1"}
           org.clj-commons/hickory           {:mvn/version "0.7.7"}
           net.eighttrigrams/defn-over-http  {:mvn/version "0.2.0"}
           ;; Line-level provenance, as a sibling checkout rather than a
           ;; coordinate. :local/root is resolved relative to *this file*, so
           ;; the checkout has to sit beside rhizome's -- in the box that means
           ;; /workspace/us-vs-them, which docker/docker-compose.yml mounts
           ;; read-only for exactly this reason. A clone without the sibling
           ;; fails on the first clj invocation, not at the point of use.
           eighttrigrams/us-vs-them          {:local/root "../us-vs-them"}
           com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
           com.github.seancorfield/honeysql  {:mvn/version "2.7.1389"}
           org.xerial/sqlite-jdbc            {:mvn/version "3.53.2.0"}
           cambium/cambium.core              {:mvn/version "1.1.1"}
           cambium/cambium.codec-simple      {:mvn/version "1.0.0"}
           cambium/cambium.logback.core      {:mvn/version "0.4.6"}
           ch.qos.logback/logback-classic    {:mvn/version "1.5.18"}
           tick/tick                         {:mvn/version "1.0.1"}
           aero/aero                         {:mvn/version "1.1.6"}}
 :aliases {:dev   {:extra-paths ["env/dev" "test/unit" "test/integration"]}
           ;; e2e mode reuses config.edn (same port, same :semsearch). The
           ;; sysprop signals config.clj to force :dev? :e2e? :bind-host and
           ;; hardcode the db to ./test/rhizome-e2e.db.
           :e2e   {:jvm-opts ["-Drhizome.e2e=1"]}
           :test  {:extra-paths ["test/unit" "test/integration" "env/test"]
                   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                       :git/sha "dfb30dd"}
                                 ring/ring-mock                       {:mvn/version "0.4.0"}
                                 com.cognitect/transit-clj            {:mvn/version "1.0.333"}}
                   ;; Mirrors the :e2e alias: the sysprop tells config.clj
                   ;; to force :dev?/:test? and hardcode the db to
                   ;; ./test/rhizome-test.db, so tests reuse main config.edn
                   ;; (port, :semsearch) instead of a parallel test_config.edn.
                   :jvm-opts    ["-Drhizome.test=1"]
                   :main-opts   ["-m" "cognitect.test-runner"
                                 "-d" "test/unit"
                                 "-d" "test/integration"]
                   :exec-fn     cognitect.test-runner.api/test
                   :exec-args   {:dirs ["test/unit" "test/integration"]}}
           :build {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd38dc39cb1880bd990d85718d4a61e194d"}}
                   :ns-default build}
           :migrate {:extra-paths ["scripts"]
                     :extra-deps  {org.postgresql/postgresql {:mvn/version "42.2.10"}}
                     :main-opts   ["-m" "migrate-pg-to-sqlite"]}
           :ingest-dump {:extra-paths ["scripts"]
                         :main-opts   ["-m" "ingest-pg-dump"]}}}
