{:paths   ["resources" "src/clj" "env/prod"]
 :deps    {cheshire/cheshire                 {:mvn/version "5.11.0"}
           ring/ring-jetty-adapter           {:mvn/version "1.9.5"}
           compojure/compojure               {:mvn/version "1.7.0"}
           ring/ring-json                    {:mvn/version "0.5.1"}
           ring/ring-devel                   {:mvn/version "1.9.5"}
           ring/ring-codec                   {:mvn/version "1.2.0"}
           clj-http/clj-http                 {:mvn/version "3.12.3"}
           org.clj-commons/hickory           {:mvn/version "0.7.4"}
           net.eighttrigrams/defn-over-http  {:mvn/version "0.2.0"}
           com.github.seancorfield/next.jdbc {:mvn/version "1.3.847"}
           com.github.seancorfield/honeysql  {:mvn/version "2.6.1147"}
           org.xerial/sqlite-jdbc            {:mvn/version "3.44.1.0"}
           cambium/cambium.core              {:mvn/version "1.1.1"}
           cambium/cambium.codec-simple      {:mvn/version "1.0.0"}
           cambium/cambium.logback.core      {:mvn/version "0.4.5"}
           tick/tick                         {:mvn/version "1.0"}
           aero/aero                         {:mvn/version "1.1.6"}}
 :aliases {:dev   {:extra-paths ["env/dev" "test/unit" "test/integration"]}
           ;; e2e mode reuses config.edn (same port, same :semsearch). The
           ;; sysprop signals config.clj to force :dev? :e2e? :bind-host and
           ;; hardcode the db to ./test/rhizome-e2e.db.
           :e2e   {:jvm-opts ["-Drhizome.e2e=1"]}
           :test  {:extra-paths ["test/unit" "test/integration" "env/test"]
                   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                       :git/sha "dfb30dd"}
                                 ring/ring-mock                       {:mvn/version "0.4.0"}
                                 com.cognitect/transit-clj            {:mvn/version "1.0.333"}}
                   ;; Mirrors the :e2e alias: the sysprop tells config.clj
                   ;; to force :dev?/:test? and hardcode the db to
                   ;; ./test/rhizome-test.db, so tests reuse main config.edn
                   ;; (port, :semsearch) instead of a parallel test_config.edn.
                   :jvm-opts    ["-Drhizome.test=1"]
                   :main-opts   ["-m" "cognitect.test-runner"
                                 "-d" "test/unit"
                                 "-d" "test/integration"]
                   :exec-fn     cognitect.test-runner.api/test
                   :exec-args   {:dirs ["test/unit" "test/integration"]}}
           :build {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.6" :git/sha "52cf7d6"}}
                   :ns-default build}}}
