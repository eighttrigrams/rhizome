# Build-context staging for the yolo image's dependency pre-warm: copies of the
# checkout's deps.edn / shadow-cljs.edn / package*.json and us-vs-them's
# deps.edn, refreshed by docker/run.sh on every run. Derived files, never edited.
docker/.build-stage/
# Optional per-machine compose layer (see COMPOSE_OVERRIDE in the Makefile),
# plus the credentials it feeds the box. Keep secrets in tracker.env, not in
# the override -- this checkout's owner symlinks the override out to a synced
# dotfiles repo.
docker/docker-compose.override.yml
docker/env-vars
.envrc
nohup.out
# Per-machine marker: its presence makes this checkout the primary (the one
# instance allowed to write). Excluded from the owner's sync by the .nosync
# suffix, and never committed -- see config/read-only-replica?.
primary.nosync
